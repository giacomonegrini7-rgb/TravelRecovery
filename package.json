{
  "name": "travel-recovery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Prototipo di ricerca Travel Recovery — questionario, demo e area privata dei creator",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "node scripts/build-esbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:sql": "bash supabase/tests/run-local.sh",
    "gen:seed": "tsx scripts/gen-seed.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
